{
  "name": "good-meet-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "start": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "test:ci": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts --coverage",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false",
    "lint": "node ./node_modules/oxlint/bin/oxlint src tests",
    "sonar": "node ./node_modules/@sonar/scan/bin/sonar-scanner.js",
    "sonar:analyze": "node ./scripts/sonar-analyze.mjs",
    "sonar:start": "docker compose -f compose.sonar.yaml up -d",
    "sonar:stop": "docker compose -f compose.sonar.yaml down",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:list": "node ./node_modules/@playwright/test/cli.js test --list",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@livekit/components-core": "^0.12.14",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "livekit-client": "^2.20.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.10",
    "react-redux": "9.3.0",
    "react-router-dom": "^7.18.1",
    "sass": "^1.101.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sonar/scan": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "16.4.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.4",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
